LINES_INSERT 340 [
		// JK2MV button
		itemDef
		{
			name				mvoptionsbutton_glow
			style				WINDOW_STYLE_SHADER
			rect				20 183 170 30
			background			"gfx/menus/menu_blendbox2"			// Frame around button
			forecolor			1 1 1 1
			visible			0
			// appearance_slot		1
			decoration
		}

		itemDef
		{
			name                    mvoptionsbutton
			group                   setup_submenu
			text                    @MV_JK2MV
			type                    ITEM_TYPE_BUTTON
			style                   WINDOW_STYLE_EMPTY
			rect                    20 183 170 30
			font                    3
			textscale               0.9
			textalignx              170
			textaligny              5
			textalign               ITEM_ALIGN_RIGHT
			textstyle               3
			forecolor               0.65 0.65 1 1
			visible                 1
			descText                @MV_JK2MV_CONFIGURE_OPTIONS

			mouseEnter
			{
				show                    mvoptionsbutton_glow
			}
			mouseExit
			{
				hide                    mvoptionsbutton_glow
			}
			action
			{
				play                    "sound/interface/button1.wav"

				defer                   VideoSetup videowarningMenu ;
				show                    setup_background ;
				hide                    video ;
				hide                    applyChanges ;
				hide                    video2 ;
				hide                    vidrestart ;
				hide                    sound ;
				hide                    options ;
				hide                    langapply
				hide                    mods ;
				hide                    defaults ;
				show                    mvoptions ;
				hide			mvvideo ;
				close                   ingame_setup_modoptions ;

				setitemcolor            setup_submenu forecolor 0.65 0.65 1 1 ;
				setitemcolor            mvoptionsbutton forecolor 1 1 1 1 ;
			}
		}

		// JK2MV button
		itemDef
		{
			name				modoptionsbutton_glow
			style				WINDOW_STYLE_SHADER
			rect				20 211 170 30
			background			"gfx/menus/menu_blendbox2"			// Frame around button
			forecolor			1 1 1 1
			visible			0
			// appearance_slot		1
