LINES_INSERT 1131 [

		// vidrestart_yes when the classic preset was picked
		itemDef
		{
			name				vidrestart_yes_preset
			group				vidrestart
			text				@MENUS0_YES
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				367 241 120 32
			font				2
			textscale			1
			textalign			ITEM_ALIGN_CENTER
			textalignx			60
			textaligny			0
			descText			@MENUS0_APPLY_CHANGES_AND_THEN
			forecolor			0.65 0.65 1 1
			cvarTest			"ui_presetPending"
			showCvar			{ "classic" }
			visible			-1
			// appearance_slot		5

			action
			{
				play			"sound/interface/button1.wav" ;
				close		all ;
				exec			"preset classic" ;
				setcvar		ui_presetPending none ;
				uiScript	updatevideosetup ;
			}
