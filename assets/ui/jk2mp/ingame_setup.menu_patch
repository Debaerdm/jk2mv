LINES_INSERT 205 [

		// advanced video button
		itemDef
		{
			name				mvvideobutton_glow
			style				WINDOW_STYLE_SHADER
			rect				20 99 170 30
			background			"gfx/menus/menu_blendbox2"			// Frame around button
			forecolor			1 1 1 1
			visible			0
			// appearance_slot		1
			decoration
		}

		itemDef
		{
			name				mvvideobutton
			group				setup_submenu
			text				@MV_ADVANCED
			type				ITEM_TYPE_BUTTON
			style				WINDOW_STYLE_EMPTY
			rect				20 99 170 30
			font				3
			textscale			0.9
			textalignx			170
			textaligny			5
			textalign			ITEM_ALIGN_RIGHT
			textstyle			3
			forecolor			0.65 0.65 1 1
			visible			1
			descText			@MV_ADVANCED_INFO

			mouseEnter
			{
				show			mvvideobutton_glow
			}
			mouseExit
			{
				hide			mvvideobutton_glow
			}
			action
			{
				play			"sound/interface/button1.wav" ;

				defer			VideoSetup	videowarningMenu ;

				uiScript		getvideosetup ;		// Get video settings
				setcvartocvar	ui_preset cl_preset ;
				setcvar			ui_presetPending none ;
				setcvar			ui_setupVideoPage advanced ;

				show			setup_background ;
				hide			video ;
				hide			applyChanges ;
				hide			video2 ;
				hide			vidrestart ;
				hide			sound ;
				hide			options ;
				hide			mvoptions ;
				show			mvvideo ;
				hide			mods ;
				hide			defaults ;
				close			ingame_setup_modoptions ;

				setitemcolor	setup_submenu		forecolor	0.65 0.65 1 1 ;
				setitemcolor	mvvideobutton		forecolor	1 1 1 1 ;
			}
		}
]

