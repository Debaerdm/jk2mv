		{
			name                    modoptionsbutton
			group                   setup_submenu
			text                    @MV_MOD_OPTIONS
			type                    ITEM_TYPE_BUTTON
			style                   WINDOW_STYLE_EMPTY
			rect                    20 211 170 30
			font                    3
			textscale               0.9
			textalignx              170
			textaligny              5
			textalign               ITEM_ALIGN_RIGHT
			textstyle               3
			forecolor               0.65 0.65 1 1
			visible                 1
			descText                @MV_MOD_OPTIONS_INFO

			mouseEnter
			{
				show                    modoptionsbutton_glow
			}
			mouseExit
			{
				hide                    modoptionsbutton_glow
			}
			action
			{
				play                    "sound/interface/button1.wav"

				defer                   VideoSetup videowarningMenu ;
				show                    setup_background ;
				hide                    video ;
				hide                    applyChanges ;
				hide                    video2 ;
				hide                    vidrestart ;
				hide                    sound ;
				hide                    options ;
				hide                    langapply
				hide                    mods ;
				hide                    defaults ;
				hide                    mvoptions ;
				hide			mvvideo ;
				open			ingame_setup_modoptions ;

				setitemcolor            setup_submenu forecolor 0.65 0.65 1 1 ;
				setitemcolor            modoptionsbutton forecolor 1 1 1 1 ;
			}
		}
